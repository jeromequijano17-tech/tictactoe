# Copy to .env and fill in. NEVER commit .env.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ttt_app
DB_PASSWORD=change-me
DB_NAME=tictactoe
# Comma-separated public origins allowed for WebSockets, e.g. https://ttt.example.com (empty = same-origin only)
ALLOWED_ORIGINS=
# Set to 0 only for local HTTP development
COOKIE_SECURE=1
# Set to 1 when behind a reverse proxy / PaaS load balancer
TRUST_PROXY=1
PORT=5000
